      "checkConstraints": {
        "bookings_kind_check": {
          "name": "bookings_kind_check",
          "value": "\"bookings\".\"kind\" in ('booking', 'block')"
        },
        "bookings_status_check": {
          "name": "bookings_status_check",
          "value": "\"bookings\".\"status\" in ('held', 'confirmed', 'completed', 'no_show', 'cancelled', 'expired')"
        },
        "bookings_deposit_check": {
          "name": "bookings_deposit_check",
          "value": "\"bookings\".\"deposit_status\" in ('none', 'paid', 'refund_pending', 'refunded', 'kept')"
        },
        "bookings_time_check": {
          "name": "bookings_time_check",
          "value": "\"bookings\".\"ends_at\" > \"bookings\".\"starts_at\""
        },
        "bookings_hold_check": {
          "name": "bookings_hold_check",
          "value": "\"bookings\".\"status\" <> 'held' or \"bookings\".\"hold_expires_at\" is not null"
        },
        "bookings_customer_check": {
          "name": "bookings_customer_check",
          "value": "\"bookings\".\"kind\" = 'block' or (\"bookings\".\"customer_name\" is not null and \"bookings\".\"customer_email\" is not null and \"bookings\".\"service_id\" is not null and \"bookings\".\"price_pence\" is not null and \"bookings\".\"deposit_pence\" is not null)"
        },
        "bookings_text_length_check": {
          "name": "bookings_text_length_check",
          "value": "coalesce(length(\"bookings\".\"customer_name\"), 0) <= 60 and coalesce(length(\"bookings\".\"customer_email\"), 0) <= 254"
        }
      },
