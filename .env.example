# Copy to .env.local for local development. Never commit real values.

# Stripe sandbox only: the app and the build refuse any key not starting sk_test_ or rk_test_.
STRIPE_SECRET_KEY=

# Neon Postgres. Local runs and tests use the test database. The PRODUCTION_ pair is read only by
# the production migration and env-push scripts, never by the running app.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PRODUCTION_DATABASE_URL=
PRODUCTION_DATABASE_URL_UNPOOLED=

# Long random values (for example: openssl rand -hex 32).
BETTER_AUTH_SECRET=
IP_HASH_SALT=
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs customers' private links, and the owner's sign-in for the diary.
MANAGE_LINK_SECRET=
OWNER_PASSWORD=

# Set only in Vercel Production, from the webhook created in Stripe's sandbox.
# STRIPE_WEBHOOK_SECRET=
